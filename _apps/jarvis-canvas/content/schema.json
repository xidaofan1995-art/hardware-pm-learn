{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis-canvas:artifact-index:v1",
  "title": "Jarvis Canvas artifact index entry",
  "description": "Only display metadata belongs in GitHub. Original files stay in Google Drive with their existing access permissions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "project", "producer", "type", "summary", "createdAt", "status", "demoContent", "drive"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,99}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "project": {"type": "string", "minLength": 1, "maxLength": 100},
    "producer": {"type": "string", "minLength": 1, "maxLength": 80},
    "type": {"enum": ["report", "table", "html", "note", "link"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "createdAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["demo", "ready"]},
    "demoContent": {"type": "boolean"},
    "archiveConfirmed": {"type": "boolean", "description": "An authorized uploader confirmed the archive reference. This does not grant permissions or assert that the client independently verified the file."},
    "sourceLabel": {"type": "string", "maxLength": 200},
    "metrics": {
      "type": "array", "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "value"],
        "properties": {
          "label": {"type": "string", "minLength": 1, "maxLength": 80},
          "value": {"type": "string", "minLength": 1, "maxLength": 160}
        }
      }
    },
    "items": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["title"],
        "properties": {
          "title": {"type": "string", "minLength": 1, "maxLength": 240},
          "detail": {"type": "string", "maxLength": 1000},
          "url": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 4096},
          "score": {"type": "number"}
        }
      }
    },
    "drive": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object", "additionalProperties": false,
          "required": ["fileId", "webViewLink", "mimeType", "archivedAt"],
          "properties": {
            "fileId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{10,200}$"},
            "webViewLink": {"type": "string", "format": "uri", "pattern": "^https://(drive|docs)\\.google\\.com/", "maxLength": 4096},
            "mimeType": {"type": "string", "minLength": 3, "maxLength": 150},
            "archivedAt": {"type": "string", "format": "date-time"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"demoContent": {"const": true}}, "required": ["demoContent"]},
      "then": {"properties": {"status": {"const": "demo"}, "drive": {"type": "null"}, "archiveConfirmed": {"const": false}}},
      "else": {"required": ["archiveConfirmed"], "properties": {"status": {"const": "ready"}, "drive": {"type": "object"}, "archiveConfirmed": {"const": true}}}
    }
  ]
}
