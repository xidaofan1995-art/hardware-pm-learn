{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jarvis-canvas:collection-index:v1",
  "title": "Jarvis Canvas project collection",
  "description": "Ordered references; build validates member existence, project and demo boundary.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "project",
    "summary",
    "artifactIds",
    "updatedAt",
    "demoContent"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,99}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 180
    },
    "project": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "artifactIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{2,99}$"
      }
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "demoContent": {
      "type": "boolean"
    }
  }
}
